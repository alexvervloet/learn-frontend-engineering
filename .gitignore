node_modules/
dist/
coverage/
*.log

# Build caches and framework output
.vite/
.next/
.astro/
.turbo/
*.tsbuildinfo

# Playwright
test-results/
playwright-report/
blob-report/
.playwright/

# Storybook
storybook-static/

# Secrets. Vite inlines anything prefixed VITE_ into the bundle, so a real key
# in here ships to every visitor. Only .env.example is committed.
.env
.env.*
!.env.example

# Working notes for whoever is mid-task. Never part of the repo.
PLAN.md

# VS Code Local History extension
.history/

# macOS
.DS_Store

# Playwright's local browser download marker (browsers live in ~/Library/Caches)
learning/*/test-results/

# Next.js
**/.next/
# Generated by `next dev` and `next build`, and regenerated whenever the Next
# version changes. It was ignored under learning/ and committed under projects/,
# which meant one of the two modules had a diff on it after every build.
**/next-env.d.ts

# Astro
learning/*/.astro/
