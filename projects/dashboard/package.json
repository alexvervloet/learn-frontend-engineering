    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3"
  }
}
