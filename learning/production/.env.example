# Copied to .env and filled in locally. .env itself is gitignored repo-wide.
#
# Anything prefixed VITE_ is INLINED INTO THE BUNDLE at build time. It is
# public. Treat every one of these as if it were printed on the home page,
# because effectively it is.
VITE_API_URL=https://api.example.com
VITE_SENTRY_DSN=https://public-key@o0.ingest.example.com/0
VITE_COMMIT_SHA=local

# No VITE_ prefix, so this is NOT available to the browser. It is here to show
# the difference: a build script can read it, the app cannot.
DEPLOY_TOKEN=never-goes-in-the-bundle
