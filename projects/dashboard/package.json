{
  "name": "dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Capstone: a time-series chart, a virtualised table, keyboard support, and a bundle budget that fails the build",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "analyse": "ANALYSE=1 vite build",
    "budget": "node scripts/check-bundle-size.mjs",
